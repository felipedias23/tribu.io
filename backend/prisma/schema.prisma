// Schema Prisma do Tribu.io.
//
// Modelo de dados planeado: docs/modelo-dados.md e docs/arquitetura-e-decisoes.md §4.
// As entidades entram aqui na semana em que a funcionalidade é implementada.
//
// Toda alteração gera uma migration versionada (`npm run db:migrate:dev`).
// Restrições que o Prisma não expressa (CHECK, EXCLUDE) são escritas em SQL na
// própria migration — ver docs/banco-de-dados.md.
//
// Convenção: tabelas e colunas em snake_case no PostgreSQL (@@map/@map),
// camelCase no código.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Papéis de um utilizador dentro do seu escritório (decisão D4).
enum Role {
  ADMIN
  ANALYST
  VIEWER

  @@map("role")
}

/// Regimes aceites no perfil tributário. O MEI fica fora do MVP.
enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL

  @@map("tax_regime")
}

/// Estado de uma versão de regra tributária (§3.4). Só uma versão PUBLISHED
/// pode estar vigente em cada dia (EXCLUDE na migration).
enum TaxRuleVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED

  @@map("tax_rule_version_status")
}

/// Estado de uma análise (D31): COMPLETED tem resultado; INCOMPLETE regista o
/// que faltou ou impediu o cálculo.
enum AnalysisStatus {
  COMPLETED
  INCOMPLETE

  @@map("analysis_status")
}

/// Estados do Tax Radar (§3.5). Numa análise, é o estado no momento da execução
/// (histórico); o estado atual é calculado no pedido (D26).
enum RadarStatus {
  DADOS_INCOMPLETOS
  REVISAR_REGRA
  REQUER_ANALISE
  OPORTUNIDADE_PARA_AVALIAR
  NORMAL

  @@map("radar_status")
}

/// Tipo de origem de dados (D36). Conectores futuros acrescentam tipos.
enum IntegrationType {
  FILE

  @@map("integration_type")
}

/// Estado de uma importação (D37). Só PREVIEW guarda as linhas da prévia.
enum ImportBatchStatus {
  PREVIEW
  CONFIRMED
  CANCELLED
  EXPIRED

  @@map("import_batch_status")
}

/// Escritório de contabilidade: o tenant. Toda entidade do tenant referencia
/// esta tabela por `accountingFirmId`.
model AccountingFirm {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// Opcional; 14 caracteres sem pontuação (CHECK na migration).
  cnpj      String?  @unique @db.Char(14)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users        User[]
  companies    Company[]
  integrations Integration[]

  @@map("accounting_firms")
}

/// Utilizador de um escritório. O email é único globalmente porque o login é
/// feito só com email e password, antes de se conhecer o tenant.
model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountingFirmId String   @map("accounting_firm_id") @db.Uuid
  name             String
  /// Sempre em minúsculas (CHECK na migration).
  email            String   @unique
  /// Hash argon2; a password em texto nunca é guardada.
  passwordHash     String   @map("password_hash")
  role             Role
  /// Incrementado no logout para invalidar tokens já emitidos (decisão D7).
  tokenVersion     Int      @default(0) @map("token_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accountingFirm AccountingFirm @relation(fields: [accountingFirmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  analyses       Analysis[]
  importBatches  ImportBatch[]

  /// Alvo das FKs compostas das tabelas filhas (decisão D15).
  @@unique([id, accountingFirmId])
  @@index([accountingFirmId])
  @@map("users")
}

/// Empresa cliente do escritório (US06). IDs de sistemas externos não entram
/// aqui: ficam em ExternalCompanyMapping (camada de integração).
model Company {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountingFirmId String   @map("accounting_firm_id") @db.Uuid
  /// 14 caracteres sem pontuação, numérico ou alfanumérico (CHECK na migration).
  cnpj             String   @db.Char(14)
  /// Razão social.
  legalName        String   @map("legal_name")
  /// Nome fantasia; opcional.
  tradeName        String?  @map("trade_name")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accountingFirm AccountingFirm           @relation(fields: [accountingFirmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxProfile     TaxProfile?
  analyses       Analysis[]
  externalIds    ExternalCompanyMapping[]

  /// O CNPJ não se repete dentro do escritório (regra S9).
  @@unique([accountingFirmId, cnpj])
  /// Alvo das FKs compostas das tabelas filhas (decisão D15).
  @@unique([id, accountingFirmId])
  @@index([accountingFirmId, legalName])
  @@map("companies")
}

/// Dados tributários de uma empresa (US08), 1:1. Todos os campos tributários
/// são anuláveis: NULL é dado ausente, distinto de zero (decisão D20).
model TaxProfile {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountingFirmId String     @map("accounting_firm_id") @db.Uuid
  companyId        String     @map("company_id") @db.Uuid
  taxRegime        TaxRegime? @map("tax_regime")
  /// 7 dígitos sem pontuação (CHECK na migration).
  cnae             String?    @db.Char(7)
  /// Nome do município.
  city             String?
  /// UF (CHECK com as 27 siglas na migration).
  state            String?    @db.Char(2)
  /// Receita bruta dos 12 meses anteriores ao período (RBT12).
  revenue12m       Decimal?   @map("revenue_12m") @db.Decimal(15, 2)
  /// Folha de pagamento dos mesmos 12 meses.
  payroll12m       Decimal?   @map("payroll_12m") @db.Decimal(15, 2)
  /// Mês de referência, guardado como o 1.º dia do mês.
  referencePeriod  DateTime?  @map("reference_period") @db.Date
  /// Atividade sujeita ao Fator R (LC 123/2006, art. 18, §§ 5º-I e 5º-M);
  /// NULL = não informado (D33).
  fatorRSubject    Boolean?   @map("fator_r_subject")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// FK composta (decisão D15): o perfil e a empresa são do mesmo escritório.
  company Company @relation(fields: [companyId, accountingFirmId], references: [id, accountingFirmId], onDelete: Restrict, onUpdate: Restrict)

  /// Um perfil por empresa. A ordem é a da FK composta (exigência do Prisma).
  @@unique([companyId, accountingFirmId])
  @@index([accountingFirmId])
  @@map("tax_profiles")
}

/// Catálogo global de regras tributárias (§3.4). Não pertence a um escritório
/// e não tem endpoint de escrita: muda só por migration (regra S11).
model TaxRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Ex.: SIMPLES_FATOR_R (CHECK na migration).
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions TaxRuleVersion[]

  @@map("tax_rules")
}

/// Versão de uma regra, com vigência e parâmetros. Uma versão publicada é
/// imutável (trigger na migration): uma mudança gera uma versão nova.
model TaxRuleVersion {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxRuleId    String               @map("tax_rule_id") @db.Uuid
  version      Int
  /// Primeiro dia de vigência.
  validFrom    DateTime             @map("valid_from") @db.Date
  /// Primeiro dia em que já não vale (exclusivo); NULL = em vigor sem fim.
  validUntil   DateTime?            @map("valid_until") @db.Date
  /// Parâmetros lidos pelo evaluator (ex.: faixas e alíquotas); valores
  /// decimais como texto, para não perder precisão.
  parameters   Json                 @db.JsonB
  /// Base legal.
  source       String
  /// Evaluator que interpreta os parâmetros, ex.: SIMPLES_FATOR_R@1.
  evaluatorKey String               @map("evaluator_key")
  status       TaxRuleVersionStatus
  /// SHA-256 (hex) do JSON canónico dos parâmetros.
  checksum     String               @db.Char(64)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  taxRule  TaxRule    @relation(fields: [taxRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  analyses Analysis[]

  @@unique([taxRuleId, version])
  @@map("tax_rule_versions")
}

/// Execução de uma regra tributária sobre uma empresa (US09). Imutável (trigger
/// na migration): uma nova execução cria um registo novo. Guarda a entrada, a
/// versão da regra, o checksum dos parâmetros e o raciocínio, para que o
/// resultado possa ser reproduzido (§3.4).
model Analysis {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountingFirmId   String         @map("accounting_firm_id") @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  executedById       String         @map("executed_by_id") @db.Uuid
  /// NULL só em INCOMPLETE, quando não havia versão vigente a escolher.
  taxRuleVersionId   String?        @map("tax_rule_version_id") @db.Uuid
  /// Perfil usado no cálculo (D6), decimais em texto.
  inputSnapshot      Json           @map("input_snapshot") @db.JsonB
  /// Checksum da versão usada; NULL quando não houve versão.
  parametersChecksum String?        @map("parameters_checksum") @db.Char(64)
  engineVersion      String         @map("engine_version")
  status             AnalysisStatus
  /// Estado do Radar no momento da execução (histórico, D26).
  radarStatus        RadarStatus    @map("radar_status")
  /// Resultado do cálculo; NULL em INCOMPLETE.
  result             Json?          @db.JsonB
  /// Raciocínio: passos, ausências, premissas e motivos.
  trace              Json           @db.JsonB
  executedAt         DateTime       @default(now()) @map("executed_at") @db.Timestamptz(3)

  /// FKs compostas (decisão D15): empresa e autor são do mesmo escritório.
  company        Company         @relation(fields: [companyId, accountingFirmId], references: [id, accountingFirmId], onDelete: Restrict, onUpdate: Restrict)
  executedBy     User            @relation(fields: [executedById, accountingFirmId], references: [id, accountingFirmId], onDelete: Restrict, onUpdate: Restrict)
  taxRuleVersion TaxRuleVersion? @relation(fields: [taxRuleVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Histórico da empresa, mais recente primeiro (US15).
  @@index([accountingFirmId, companyId, executedAt(sort: Desc)])
  @@map("analyses")
}

/// Origem de dados de um escritório (D36), ex.: "Sistema contábil X". A camada
/// de integração mantém os identificadores externos fora de Company.
model Integration {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountingFirmId String          @map("accounting_firm_id") @db.Uuid
  type             IntegrationType
  name             String
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  accountingFirm AccountingFirm           @relation(fields: [accountingFirmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mappings       ExternalCompanyMapping[]
  importBatches  ImportBatch[]

  /// O nome da origem não se repete no escritório (regra S9).
  @@unique([accountingFirmId, type, name])
  /// Alvo das FKs compostas das tabelas filhas (decisão D15).
  @@unique([id, accountingFirmId])
  @@map("integrations")
}

/// Identificador de uma empresa num sistema de origem (D36).
model ExternalCompanyMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountingFirmId String   @map("accounting_firm_id") @db.Uuid
  integrationId    String   @map("integration_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  externalId       String   @map("external_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// FKs compostas (decisão D15): origem e empresa do mesmo escritório.
  integration Integration @relation(fields: [integrationId, accountingFirmId], references: [id, accountingFirmId], onDelete: Restrict, onUpdate: Restrict)
  company     Company     @relation(fields: [companyId, accountingFirmId], references: [id, accountingFirmId], onDelete: Restrict, onUpdate: Restrict)

  /// Um id externo aponta para uma só empresa, e uma empresa tem um só id
  /// externo, em cada origem.
  @@unique([integrationId, externalId])
  @@unique([integrationId, companyId])
  @@index([accountingFirmId])
  @@map("external_company_mappings")
}

/// Uma importação de ficheiro (US12, D37): a prévia enquanto PREVIEW, só o
/// resumo depois de confirmada, cancelada ou expirada.
model ImportBatch {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountingFirmId String            @map("accounting_firm_id") @db.Uuid
  integrationId    String            @map("integration_id") @db.Uuid
  createdById      String            @map("created_by_id") @db.Uuid
  status           ImportBatchStatus
  /// Nome do ficheiro enviado (o conteúdo não é guardado, S17).
  fileName         String            @map("file_name")
  /// CSV ou XLSX (CHECK na migration).
  fileFormat       String            @map("file_format")
  /// Linhas da prévia; NULL fora de PREVIEW (D37).
  preview          Json?             @db.JsonB
  /// Contagens por resultado e colunas ignoradas.
  summary          Json              @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Fim da validade da prévia (24 horas, D37).
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  /// Quando saiu de PREVIEW; NULL enquanto PREVIEW.
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz(3)

  /// FKs compostas (decisão D15).
  integration Integration @relation(fields: [integrationId, accountingFirmId], references: [id, accountingFirmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy   User        @relation(fields: [createdById, accountingFirmId], references: [id, accountingFirmId], onDelete: Restrict, onUpdate: Restrict)

  /// Histórico de importações, mais recente primeiro.
  @@index([accountingFirmId, createdAt(sort: Desc)])
  @@map("import_batches")
}
