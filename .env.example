# Modelo de variáveis de ambiente do Tribu.io.
# Copie para `.env` (ignorado pelo Git) e ajuste os valores:
#
#   cp .env.example .env
#
# Os valores abaixo são APENAS para desenvolvimento local. Nunca reutilize-os
# em produção nem versione o arquivo `.env`.

# ─── PostgreSQL (serviço `db`) ────────────────────────────────
POSTGRES_USER=tribu
# Evite @ : / ? # % na senha (ela é inserida na DATABASE_URL sem escape).
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tribu

# ─── Backend (serviço `backend`) ──────────────────────────────
# Usada ao executar o backend fora do Docker (npm run start:dev, migrations, seed).
# Dentro do Docker Compose a URL é montada automaticamente apontando para `db`.
DATABASE_URL=postgresql://tribu:change-me-local-only@localhost:5432/tribu?schema=public
NODE_ENV=development
# Segredo que assina os JWT de sessão (mínimo 32 caracteres). Gere um valor
# próprio, ex.: openssl rand -base64 48. Trocá-lo termina todas as sessões.
JWT_SECRET=change-me-local-only-with-at-least-32-characters
# Cookie de sessão só por HTTPS. Em produção o padrão é true; no ambiente local
# (http://localhost) fica false.
COOKIE_SECURE=false

# ─── Seed de desenvolvimento ──────────────────────────────────
# Password das contas fictícias criadas pelo seed (mínimo 8 caracteres).
# Só é aplicada quando a conta é criada; ver docs/banco-de-dados.md.
SEED_PASSWORD=change-me-demo-only
# Executa migrations + seed ao iniciar o container do backend.
SEED_ON_START=true

# ─── Portas publicadas no host ────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=5432
