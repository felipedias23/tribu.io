# Modelo de variáveis de ambiente do Tribu.io.
# Copie para `.env` (ignorado pelo Git) e ajuste os valores:
#
#   cp .env.example .env
#
# Os valores abaixo são APENAS para desenvolvimento local. Nunca reutilize-os
# em produção nem versione o arquivo `.env`.

# ─── PostgreSQL (serviço `db`) ────────────────────────────────
POSTGRES_USER=tribu
# Evite @ : / ? # % na senha (ela é inserida na DATABASE_URL sem escape).
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tribu

# ─── Backend (serviço `backend`) ──────────────────────────────
# Usada ao executar o backend fora do Docker (npm run start:dev).
# Dentro do Docker Compose a URL é montada automaticamente apontando para `db`.
DATABASE_URL=postgresql://tribu:change-me-local-only@localhost:5432/tribu?schema=public
NODE_ENV=development

# ─── Portas publicadas no host ────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=5432
